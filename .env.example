# ============================================
# ECG Clinical Intelligence Pipeline - Secrets
# ============================================
# Copy this file to .env and fill in your credentials.
# NEVER commit the actual .env file to version control.

# --- HuggingFace (fallback LLM) ---
HF_TOKEN=your_hf_token_here
HF_TOKENS=your_hf_token_here

# --- Groq API (primary LLM) ---
# Single key (simple setup)
GROQ_API_KEY=your_groq_api_key_here
# Comma-separated list for key rotation (overrides GROQ_API_KEY if set)
GROQ_API_KEYS=key1,key2,key3
GROQ_MODEL=openai/gpt-oss-20b

# --- LLM Mode: groq | inference | test | fake ---
LLM_MODE=groq

# --- Local Model (for test mode) ---
LOCAL_LLM_MODEL_PATH=

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecg_agent_data
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# --- PDF Knowledge Base ---
PDF_DOCUMENT_NAME=Cardiac_Diagnostics_Comprehensive_KB.pdf
PDF_DEFAULT_PATH=Cardiac_Diagnostics_Comprehensive_KB.pdf

# --- Kafka (optional streaming — requires kafka-python) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=ecg-processor
KAFKA_RAW_INPUT_TOPIC=ecg.raw.signal
KAFKA_TEMPORAL_EVENTS_TOPIC=ecg.events.temporal
KAFKA_CLINICAL_RESULTS_TOPIC=ecg.results.clinical
KAFKA_PATIENT_REGISTRATION_TOPIC=ecg.patient.registration